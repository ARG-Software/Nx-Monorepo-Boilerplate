    "@nestjs/schedule": "5.0.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@tanstack/react-query": "^5.65.1",
    "bcrypt": "6.0.0",
    "bull": "^4.16.5",
    "cache-manager": "6.4.3",
