    "rxjs": "7.8.2",
    "tailwindcss": "^3.4.17",
    "winston": "^3.17.0",
    "winston-errsole": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
