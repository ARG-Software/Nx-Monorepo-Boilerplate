    "kafkajs": "^2.2.4",
    "keyv": "5.6.0",
    "koa": "3.1.2",
    "nestjs-request-context": "4.0.0",
    "next": "15.5.25",
    "passport": "0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^18.3.1",
