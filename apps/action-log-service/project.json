{
  "name": "action-log-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/action-log-service/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "defaultConfiguration": "development",
      "options": {
        "main": "apps/action-log-service/src/main.ts",
        "outputFileName": "main.js",
        "tsConfig": "apps/action-log-service/tsconfig.app.json",
        "target": "node",
        "compiler": "tsc",
        "webpackConfig": "apps/action-log-service/webpack.config.js"
      },
      "configurations": {
        "production": {
          "outputPath": "apps/action-log-service/dist/production",
          "optimization": true,
          "generatePackageJson": true,
          "generateLockfile": true
        },
        "development": {
          "outputPath": "apps/action-log-service/dist/development",
          "optimization": false,
          "extractLicenses": false,
          "watch": true,
          "sourceMap": true
        }
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        {
          "json": "{workspaceRoot}/package.json",
          "fields": [
            "packageManager",
            "pnpm.onlyBuiltDependencies",
            "pnpm.neverBuiltDependencies",
            "pnpm.allowBuilds",
            "pnpm.supportedArchitectures",
            "pnpm.patchedDependencies"
          ]
        },
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ]
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "action-log-service:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "action-log-service:build:production",
          "inspect": false,
          "watch": false,
          "waitUntilTargets": ["action-log-service:build:production"]
        },
        "development": {
          "buildTarget": "action-log-service:build:development",
          "inspect": true,
          "watch": true,
          "waitUntilTargets": ["action-log-service:build:development"]
        }
      }
    },
    "versioning": {
      "executor": "@jscutlery/semver:version",
      "parallelism": false,
      "options": {
        "baseBranch": "main",
        "syncVersions": false,
        "noVerify": false,
        "push": false,
        "remote": "origin",
        "tagPrefix": "{projectName}-"
      }
    },
    "publish-docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "parallelism": false,
      "options": {
        "command": "node ./tools/docker/publish_docker.js {projectName} true"
      }
    },
    "generate-docker-image": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node ./tools/docker/publish_docker.js {projectName}"
      }
    }
  }
}
