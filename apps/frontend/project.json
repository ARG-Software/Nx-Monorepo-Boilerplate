{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "defaultConfiguration": "development",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        {
          "json": "{workspaceRoot}/package.json",
          "fields": [
            "packageManager",
            "pnpm.onlyBuiltDependencies",
            "pnpm.neverBuiltDependencies",
            "pnpm.allowBuilds",
            "pnpm.supportedArchitectures",
            "pnpm.patchedDependencies"
          ]
        },
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        },
        {
          "externalDependencies": ["next"]
        }
      ],
      "configurations": {
        "development": {
          "args": ["--debug"]
        },
        "production": {}
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "configurations": {
        "development": {
          "port": 8081,
          "args": ["--experimental-https"]
        }
      }
    },
    "versioning": {
      "executor": "@jscutlery/semver:version",
      "parallelism": false,
      "options": {
        "baseBranch": "main",
        "syncVersions": false,
        "noVerify": false,
        "push": false,
        "remote": "origin",
        "tagPrefix": "{projectName}-"
      }
    },
    "publish-docker": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "parallelism": false,
      "options": {
        "command": "node ./tools/docker/publish_docker.js {projectName} true"
      }
    },
    "generate-docker-image": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node ./tools/docker/publish_docker.js {projectName}"
      }
    }
  }
}
